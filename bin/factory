#!/usr/bin/env bash
# Install and update the orca factory kit in a project.
#
#   bin/factory init   <target>   copy the kit into a project, render templates
#   bin/factory update [target]   re-sync the synced set, report drift
#   bin/factory check  [target]   run the project's gates
#   bin/factory self-update       update the factory clone itself (git pull)
#   bin/factory version           print the factory version and commit
#
# Three categories of file, and which one a file is in decides who may edit it:
#
#   SYNCED     the factory owns it. `update` overwrites. Edit it in the factory.
#   TEMPLATED  generated once at init. `update` never touches it. Yours after.
#   PROJECT    your content. The factory never touches it.
set -uo pipefail

FACTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SYNCED_DIRS="roles skills"
SYNCED_FILES="orca/README.md orca/dispatch.sh orca/pipeline.yaml cards/README.md .gitattributes evals/golden/run.sh"
TEMPLATED="AGENTS.md CLAUDE.md evals/run.sh docs/index.md"
STAMP=".factory-version"
# KIT_VERSION is the STAMP SCHEMA version — it changes when .factory-version's
# format changes, not when the factory ships. The factory's release version is
# a separate concept, read from VERSION below.
KIT_VERSION=1
FACTORY_VERSION="$(sed -n '1p' "$FACTORY/VERSION" 2>/dev/null || echo unknown)"

die() { echo "error: $*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

hash_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else python -c "import hashlib,sys;print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())" "$1"; fi
}

# Every synced file, as repo-relative paths.
synced_list() {
  ( cd "$FACTORY" || exit 1
    for d in $SYNCED_DIRS; do find "$d" -type f 2>/dev/null; done
    for f in $SYNCED_FILES; do [ -f "$f" ] && echo "$f"; done
  ) | sort
}

# ---------------------------------------------------------------- stack detect
detect_stack() {
  local t="$1"
  TEST_CMD="TODO: your test command"
  LINT_CMD="TODO: your lint command"
  TYPECHECK_CMD="TODO: your typecheck command"
  STACK="unknown"
  if [ -f "$t/package.json" ]; then
    STACK="node"
    TEST_CMD="npm test"; LINT_CMD="npm run lint"; TYPECHECK_CMD="npm run typecheck"
  elif [ -f "$t/pyproject.toml" ] || [ -f "$t/setup.cfg" ]; then
    STACK="python"
    TEST_CMD="pytest -q"; LINT_CMD="ruff check ."; TYPECHECK_CMD="mypy ."
  elif [ -f "$t/go.mod" ]; then
    STACK="go"
    TEST_CMD="go test ./..."; LINT_CMD="go vet ./..."; TYPECHECK_CMD="go build ./..."
  elif [ -f "$t/Cargo.toml" ]; then
    STACK="rust"
    TEST_CMD="cargo test"; LINT_CMD="cargo clippy -- -D warnings"; TYPECHECK_CMD="cargo check"
  fi
}

render() { # render <template> <dest> <project> <description>
  sed -e "s|{{PROJECT}}|$3|g" \
      -e "s|{{DESCRIPTION}}|$4|g" \
      -e "s|{{TEST_CMD}}|$TEST_CMD|g" \
      -e "s|{{LINT_CMD}}|$LINT_CMD|g" \
      -e "s|{{TYPECHECK_CMD}}|$TYPECHECK_CMD|g" \
      "$1" > "$2"
}

# ------------------------------------------------------------------------ init
cmd_init() {
  local t="${1:-}"; [ -n "$t" ] || die "usage: factory init <target>"
  mkdir -p "$t" || die "cannot create $t"
  t="$(cd "$t" && pwd)"
  [ "$t" = "$FACTORY" ] && die "refusing to initialize the factory into itself"
  [ -f "$t/$STAMP" ] && die "$t is already initialized (see $STAMP); use 'factory update'"

  local project desc
  project="$(basename "$t")"
  desc="${2:-TODO: one paragraph on what this system does and who depends on it.}"
  detect_stack "$t"

  say "init $project  (stack: $STACK)"

  # SYNCED
  local n=0
  while IFS= read -r f; do
    mkdir -p "$t/$(dirname "$f")"
    cp "$FACTORY/$f" "$t/$f"
    n=$((n+1))
  done < <(synced_list)
  say "  synced      $n files"

  # TEMPLATED -- never overwrite something already there
  mkdir -p "$t/evals" "$t/docs"
  local tm=0
  for pair in "AGENTS.md.tmpl:AGENTS.md" "CLAUDE.md.tmpl:CLAUDE.md" \
              "evals-run.sh.tmpl:evals/run.sh" "docs-index.md.tmpl:docs/index.md"; do
    src="${pair%%:*}"; dst="${pair##*:}"
    if [ -e "$t/$dst" ]; then
      say "  kept        $dst (already present)"
    else
      render "$FACTORY/template/$src" "$t/$dst" "$project" "$desc"
      tm=$((tm+1))
    fi
  done
  chmod +x "$t/evals/run.sh" "$t/orca/dispatch.sh" 2>/dev/null
  say "  rendered    $tm templates"

  # PROJECT
  for d in cards docs/behavior docs/decisions docs/lessons docs/qa/evidence evals/golden reports; do
    mkdir -p "$t/$d"; [ -e "$t/$d/.gitkeep" ] || : > "$t/$d/.gitkeep"
  done

  write_stamp "$t"
  say "  stamped     $STAMP (kit v$KIT_VERSION)"
  say ""
  say "next:"
  say "  cd $t && ./evals/run.sh"
  [ "$STACK" = "unknown" ] && say "  ! stack not detected — edit the TODO commands in evals/run.sh and AGENTS.md"
}

write_stamp() {
  local t="$1" sha
  sha="$(cd "$FACTORY" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
  {
    echo "# Written by the orca factory. Do not edit by hand."
    echo "version=$KIT_VERSION"
    echo "source_commit=$sha"
    echo "initialized=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "# sha256 of each synced file as installed; 'factory update' compares"
    echo "# against these to detect local edits before it overwrites anything."
    while IFS= read -r f; do
      [ -f "$t/$f" ] && echo "$(hash_of "$t/$f")  $f"
    done < <(synced_list)
  } > "$t/$STAMP"
}

# ---------------------------------------------------------------------- update
cmd_update() {
  local t="${1:-$PWD}" force="${FORCE:-}"
  t="$(cd "$t" && pwd)" || die "no such target"
  [ -f "$t/$STAMP" ] || die "$t is not initialized; use 'factory init'"
  [ "$t" = "$FACTORY" ] && die "refusing to update the factory from itself"

  local drift="" updated=0 added=0
  while IFS= read -r f; do
    recorded="$(grep -E "  $f\$" "$t/$STAMP" | cut -d' ' -f1 | head -1)"
    if [ ! -f "$t/$f" ]; then
      mkdir -p "$t/$(dirname "$f")"; cp "$FACTORY/$f" "$t/$f"; added=$((added+1)); continue
    fi
    current="$(hash_of "$t/$f")"
    factory="$(hash_of "$FACTORY/$f")"
    [ "$current" = "$factory" ] && continue          # already current
    if [ -n "$recorded" ] && [ "$current" != "$recorded" ] && [ -z "$force" ]; then
      drift="$drift$f "                              # locally edited: do not clobber
      continue
    fi
    cp "$FACTORY/$f" "$t/$f"; updated=$((updated+1))
  done < <(synced_list)

  say "update $(basename "$t")"
  say "  updated     $updated files"
  say "  added       $added files"

  if [ -n "$drift" ]; then
    say ""
    say "  STOPPED — these synced files were edited locally:"
    for f in $drift; do
      say "    $f"
      command -v git >/dev/null 2>&1 && git --no-pager diff --no-index --stat "$t/$f" "$FACTORY/$f" 2>/dev/null | sed 's/^/      /'
    done
    say ""
    say "  Synced files belong to the factory. Move the change there, or re-run"
    say "  with FORCE=1 to discard it. Nothing was overwritten."
    return 1
  fi

  write_stamp "$t"
  say "  templated files untouched: $TEMPLATED"
  return 0
}

cmd_check() {
  local t="${1:-$PWD}"; t="$(cd "$t" && pwd)" || die "no such target"
  [ -x "$t/evals/run.sh" ] || die "$t/evals/run.sh not found or not executable"
  ( cd "$t" && ./evals/run.sh )
}

# ---------------------------------------------------------------- self-update
cmd_self_update() {
  git -C "$FACTORY" rev-parse --git-dir >/dev/null 2>&1 \
    || die "self-update needs a git clone; $FACTORY is not one"
  git -C "$FACTORY" diff --quiet && git -C "$FACTORY" diff --cached --quiet \
    || die "local changes in $FACTORY — commit or revert them; an installed factory tracks upstream"
  local old_sha new_sha old_ver new_ver out
  old_sha="$(git -C "$FACTORY" rev-parse --short HEAD)"
  old_ver="$(sed -n '1p' "$FACTORY/VERSION" 2>/dev/null || echo unknown)"
  say "self-update $FACTORY  (was $old_sha)"
  out="$(git -C "$FACTORY" pull --ff-only 2>&1)" || die "git pull failed: $out"
  new_sha="$(git -C "$FACTORY" rev-parse --short HEAD)"
  new_ver="$(sed -n '1p' "$FACTORY/VERSION" 2>/dev/null || echo unknown)"

  if [ "$old_sha" = "$new_sha" ]; then
    say "  current    $new_ver ($new_sha)"
    return 0
  fi
  say "  updated    $old_sha -> $new_sha"
  if [ "$old_ver" != "$new_ver" ]; then
    say "  version    $old_ver -> $new_ver"
    changelog_excerpt "$new_ver"
  fi
}

# Print the CHANGELOG.md section for <version> — `self-update` should say what
# changed, not just that something did. The heading is matched as a prefix
# (Keep a Changelog appends " - date"), by string compare, not regex — dots in
# a version would otherwise match anything.
changelog_excerpt() {
  local ver="$1" entry
  entry="$(awk -v want="## [$ver]" '
    index($0, want) == 1 { insec = 1; next }
    insec && /^## / { exit }
    insec && NF { print }
  ' "$FACTORY/CHANGELOG.md" 2>/dev/null | head -15)"
  [ -n "$entry" ] || return 0
  say ""
  say "  what's new in $ver:"
  printf '%s\n' "$entry" | sed 's/^/    /'
}

# --------------------------------------------------------------------- version
cmd_version() {
  local sha
  sha="$(git -C "$FACTORY" rev-parse --short HEAD 2>/dev/null || echo uncommitted)"
  say "orca factory $FACTORY_VERSION ($sha)"
}

case "${1:-}" in
  init)        shift; cmd_init "$@" ;;
  update)      shift; cmd_update "$@" ;;
  check)       shift; cmd_check "$@" ;;
  self-update) shift; cmd_self_update "$@" ;;
  version)     shift; cmd_version "$@" ;;
  *) sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
